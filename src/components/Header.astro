---
import resume from '../data/resume.json';

const { name, label, email, url, location, profiles } = resume.basics;

const github = profiles.find((profile) => profile.network.toLowerCase() === 'github');
const website = url ?? profiles.find((profile) => profile.network.toLowerCase() === 'website')?.url;

const place = [location.city, location.region].filter(Boolean).join(', ');
---

<header class="print:break-inside-avoid">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex items-start gap-5">
      <img
        src="/avatar.svg"
        alt={`${name} monogram`}
        width="96"
        height="96"
        loading="eager"
        decoding="async"
        class="h-20 w-20 shrink-0 rounded-[26.5%] object-cover ring-1 ring-black/5 dark:ring-white/10 sm:h-24 sm:w-24 print:h-16 print:w-16 print:ring-0"
      />

      <div class="min-w-0">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-[1.75rem] print:text-[16pt]">
          {name}
        </h1>
        <p class="mt-0.5 text-[0.9375rem] font-medium text-brand-700 dark:text-brand-300 print:text-[10.5pt] print:text-neutral-800">
          {label}
        </p>
        <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400 print:hidden">{place}</p>
      </div>
    </div>

    <!-- Interactive toolbar: screen only, never printed or parsed by ATS. -->
    <div class="flex flex-wrap items-center gap-2 print:hidden" role="toolbar" aria-label="Resume actions">
      <button type="button" id="print-resume" class="toolbar-btn">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Z" />
        </svg>
        <span class="hidden sm:inline">Download / Print PDF</span>
        <span class="sm:hidden">PDF</span>
      </button>

      <a href="/resume.json" target="_blank" rel="noopener noreferrer" class="toolbar-btn">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
        </svg>
        <span class="hidden sm:inline">View JSON</span>
        <span class="sm:hidden">JSON</span>
      </a>

      <button type="button" id="theme-toggle" class="toolbar-btn" aria-label="Toggle dark mode" aria-pressed="false">
        <svg class="h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <span class="sr-only">Theme</span>
      </button>
    </div>
  </div>

  <p class="mt-5 max-w-resume text-[0.9375rem] leading-relaxed text-slate-600 dark:text-slate-400 print:mt-2 print:text-[9.5pt] print:text-neutral-800">
    {resume.basics.summary}
  </p>

  <!-- Contact: real mailto/URLs, plain text labels so parsers read them. -->
  <ul class="mt-4 flex flex-wrap gap-2 print:mt-2 print:gap-x-3 print:gap-y-1">
    <li>
      <a href={`mailto:${email}`} class="contact-pill print:border-0 print:bg-transparent print:p-0 print:text-[9.5pt] print:text-neutral-800">
        <svg class="h-3.5 w-3.5 text-slate-400 print:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
        <span>{email}</span>
      </a>
    </li>

    {website && (
      <li>
        <a href={website} target="_blank" rel="noopener noreferrer" class="contact-pill print:border-0 print:bg-transparent print:p-0 print:text-[9.5pt] print:text-neutral-800">
          <svg class="h-3.5 w-3.5 text-slate-400 print:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0a8.949 8.949 0 0 0 4.951-1.488A3.987 3.987 0 0 0 13 16h-2a3.987 3.987 0 0 0-3.951 3.512A8.949 8.949 0 0 0 12 21Zm3-11.25a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          </svg>
          <span>{website.replace(/^https?:\/\//, '')}</span>
        </a>
      </li>
    )}

    {github && (
      <li>
        <a href={github.url} target="_blank" rel="noopener noreferrer" class="contact-pill print:border-0 print:bg-transparent print:p-0 print:text-[9.5pt] print:text-neutral-800">
          <svg class="h-3.5 w-3.5 text-slate-400 print:hidden" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
          </svg>
          <span>github.com/{github.username}</span>
        </a>
      </li>
    )}

    <li>
      <span class="contact-pill print:border-0 print:bg-transparent print:p-0 print:text-[9.5pt] print:text-neutral-800">
        <svg class="h-3.5 w-3.5 text-slate-400 print:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.7" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        <span>{place}</span>
      </span>
    </li>
  </ul>
</header>

<script>
  const printButton = document.getElementById('print-resume');
  printButton?.addEventListener('click', () => window.print());

  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const syncPressed = () => {
    const isDark = root.classList.contains('dark');
    toggle?.setAttribute('aria-pressed', String(isDark));
    toggle?.setAttribute('title', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  };

  syncPressed();

  toggle?.addEventListener('click', () => {
    const isDark = root.classList.toggle('dark');
    root.dataset.theme = isDark ? 'dark' : 'light';

    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (error) {
      /* private mode: theme still applies for this page view */
    }

    syncPressed();
  });
</script>
