---
interface Props {
  education: Array<{
    institution: string;
    url?: string;
    area?: string;
    studyType?: string;
    startDate?: string;
    endDate?: string;
    courses?: string[];
  }>;
}

const { education } = Astro.props;

const formatDate = (value?: string) => {
  if (!value) return undefined;
  const [year, month] = value.split('-');
  const index = month ? Number(month) - 1 : NaN;
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  return MONTHS[index] ? `${MONTHS[index]} ${year}` : year;
};

const formatRange = (entry: { startDate?: string; endDate?: string }) => {
  const start = formatDate(entry.startDate);
  const end = formatDate(entry.endDate);
  if (!start && !end) return undefined;
  return [start, end].filter(Boolean).join(' – ');
};
---

<ul class="space-y-5 print:space-y-2">
  {education.map((entry) => (
    <li class="print:break-inside-avoid">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
        <h3 class="text-[0.9375rem] font-semibold text-slate-900 dark:text-white print:text-[10pt]">
          {entry.studyType ?? entry.area}
        </h3>
        {entry.url ? (
          <a
            href={entry.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[0.8125rem] font-medium text-slate-500 transition hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300 print:text-neutral-700"
          >
            {entry.institution}
          </a>
        ) : (
          <span class="text-[0.8125rem] font-medium text-slate-500 dark:text-slate-400 print:text-neutral-700">
            {entry.institution}
          </span>
        )}
      </div>

      {entry.area && entry.studyType && (
        <p class="mt-0.5 text-[0.875rem] text-slate-600 dark:text-slate-400 print:text-[9.5pt] print:text-neutral-800">
          {entry.area}
        </p>
      )}

      {formatRange(entry) && (
        <p class="mt-0.5 text-[0.75rem] font-medium tabular-nums text-slate-400 dark:text-slate-500 print:text-[9pt] print:text-neutral-600">
          {formatRange(entry)}
        </p>
      )}

      {entry.courses && entry.courses.length > 0 && (
        <ul class="mt-1 space-y-0.5">
          {entry.courses.map((course) => (
            <li class="text-[0.875rem] leading-relaxed text-slate-600 dark:text-slate-400 print:text-[9.5pt] print:text-neutral-800">
              {course}
            </li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ul>
