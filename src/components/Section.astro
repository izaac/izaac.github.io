---
interface Props {
  title: string;
  id?: string;
  icon?: 'briefcase' | 'code' | 'academic' | 'badge' | 'heart';
  class?: string;
  /**
   * Keep the whole section on one printed page. Enable for short sections only:
   * forcing it on a section taller than a page leaves a blank page behind it.
   */
  keepTogether?: boolean;
}

const { title, id, icon = 'briefcase', class: className = '', keepTogether = false } = Astro.props;

/* Inline 24x24 stroke icons: decorative only, always paired with real text. */
const paths: Record<string, string[]> = {
  briefcase: [
    'M20.25 14.15v4.073a2.25 2.25 0 0 1-1.606 2.156l-6 1.85a2.25 2.25 0 0 1-1.288 0l-6-1.85A2.25 2.25 0 0 1 3.75 18.22V14.15',
    'M20.25 14.15a2.25 2.25 0 0 0 2.25-2.25v-1.5a2.25 2.25 0 0 0-2.25-2.25h-4.5M20.25 14.15l-6.75 2.1m0 0-6.75-2.1m6.75 2.1v3.15',
    'M6.75 8.15h-3A2.25 2.25 0 0 0 1.5 10.4v1.5a2.25 2.25 0 0 0 2.25 2.25h3m4.5-6V5.9a2.25 2.25 0 0 0-2.25-2.25h-4.5A2.25 2.25 0 0 0 2.25 5.9v2.25',
  ],
  code: ['M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25', 'M14.25 3.75l-4.5 16.5'],
  academic: ['M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5'],
  badge: ['M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'],
  heart: ['M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z'],
};

const iconPaths = paths[icon] ?? paths.briefcase;
---

<section
  id={id}
  class:list={['scroll-mt-8 py-7 sm:py-8 print:py-3', keepTogether && 'print:break-inside-avoid', className]}
  aria-labelledby={id ? `${id}-heading` : undefined}
>
  <h2
    id={id ? `${id}-heading` : undefined}
    class="mb-4 flex items-center gap-2.5 text-[0.8125rem] font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400 print:mb-2 print:text-[10pt] print:text-black"
  >
    <svg
      class="h-4 w-4 shrink-0 text-brand-600 dark:text-brand-400 print:hidden"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.6"
      stroke="currentColor"
      aria-hidden="true"
    >
      {iconPaths.map((d) => <path stroke-linecap="round" stroke-linejoin="round" d={d} />)}
    </svg>
    <span>{title}</span>
    <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800 print:bg-neutral-300"></span>
  </h2>

  <div class="space-y-5 print:space-y-2.5">
    <slot />
  </div>
</section>
