---
interface Props {
  volunteer: Array<{
    organization: string;
    position?: string;
    url?: string;
    summary?: string;
    highlights?: string[];
  }>;
}

const { volunteer } = Astro.props;
---

<ul class="space-y-5 print:space-y-2">
  {volunteer.map((entry) => (
    <li class="print:break-inside-avoid">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
        <h3 class="text-[0.9375rem] font-semibold text-slate-900 dark:text-white print:text-[10pt]">
          {entry.position ? `${entry.position}, ${entry.organization}` : entry.organization}
        </h3>
        {entry.url && (
          <a
            href={entry.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[0.8125rem] font-medium text-slate-500 transition hover:text-brand-700 dark:text-slate-400 dark:hover:text-brand-300 print:text-neutral-700"
          >
            {entry.url.replace(/^https?:\/\//, '')}
          </a>
        )}
      </div>

      {entry.summary && (
        <p class="mt-1 text-[0.875rem] leading-relaxed text-slate-600 dark:text-slate-400 print:text-[9.5pt] print:text-neutral-800">
          {entry.summary}
        </p>
      )}

      {entry.highlights && entry.highlights.length > 0 && (
        <ul class="mt-2 space-y-1 print:mt-1 print:space-y-0.5">
          {entry.highlights.map((highlight) => (
            <li class="flex gap-2 text-[0.875rem] leading-relaxed text-slate-600 dark:text-slate-400 print:text-[9.5pt] print:text-neutral-800">
              <span class="mt-[0.55em] h-1 w-1 shrink-0 rounded-full bg-brand-500 dark:bg-brand-400 print:bg-neutral-600" aria-hidden="true"></span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      )}
    </li>
  ))}
</ul>
